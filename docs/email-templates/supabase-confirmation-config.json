{
  "mailer_subjects_confirmation": "Confirmez votre inscription à LSNB Alumni",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Confirmez votre inscription à LSNB Alumni</title></head>\n<body style=\"margin:0;padding:0;background-color:#faf8f3;color:#142536;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;\">\n  <div style=\"display:none;font-size:1px;line-height:1px;color:#faf8f3;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Confirmez votre adresse e-mail pour activer votre compte.</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;background-color:#faf8f3;\"><tr><td align=\"center\" style=\"padding:28px 16px;\">\n    <!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]-->\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:600px;\">\n      <tr><td style=\"padding:26px 28px;background-color:#0c2948;border-bottom:4px solid #c27d38;\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr>\n          <td style=\"color:#fffdf8;font-size:14px;font-weight:700;letter-spacing:2px;line-height:20px;\">ALUMNI<br><span style=\"font-size:29px;letter-spacing:1px;line-height:32px;color:#e7b77d;\">LSNB</span></td>\n          <td align=\"right\" valign=\"bottom\" style=\"color:#e7b77d;font-size:12px;line-height:18px;\">Bobo-Dioulasso<br>Burkina Faso</td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:32px 28px 28px;background-color:#ffffff;border-right:1px solid #eadac6;border-left:1px solid #eadac6;\">\n        <p style=\"margin:0 0 14px;color:#76502d;font-size:12px;font-weight:700;letter-spacing:1px;line-height:18px;text-transform:uppercase;\">Votre inscription</p>\n        <h1 style=\"margin:0 0 20px;color:#0c2948;font-size:32px;font-weight:700;line-height:38px;letter-spacing:-0.7px;\">Confirmez votre adresse.</h1>\n        <p style=\"margin:0 0 26px;font-size:16px;line-height:26px;color:#425466;\">Votre demande d’inscription à LSNB Alumni a bien été reçue. Confirmez votre adresse e-mail pour activer votre compte et accéder à votre espace membre.</p>\n        <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#0c2948\" style=\"background-color:#0c2948;border:1px solid #0c2948;border-radius:4px;text-align:center;mso-padding-alt:16px 24px;\">\n          <a href=\"{{ .ConfirmationURL }}\" target=\"_blank\" rel=\"noreferrer\" style=\"display:inline-block;padding:16px 24px;border-radius:4px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;line-height:20px;text-decoration:none;\">Confirmer mon adresse</a>\n        </td></tr></table>\n        <p style=\"margin:24px 0 0;font-size:14px;line-height:22px;color:#536371;\">Ce lien est personnel et utilisable une seule fois. S’il a expiré, demandez un nouvel e-mail depuis la page de connexion du site.</p>\n      </td></tr>\n      <tr><td style=\"padding:22px 28px;background-color:#f3eee5;border:1px solid #eadac6;border-top:0;\">\n        <p style=\"margin:0 0 8px;font-size:12px;line-height:19px;color:#536371;\">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :</p>\n        <p style=\"margin:0;font-size:12px;line-height:19px;word-break:break-all;overflow-wrap:anywhere;\"><a href=\"{{ .ConfirmationURL }}\" target=\"_blank\" rel=\"noreferrer\" style=\"color:#0c2948;text-decoration:underline;word-break:break-all;overflow-wrap:anywhere;\">{{ .ConfirmationURL }}</a></p>\n      </td></tr>\n      <tr><td style=\"padding:22px 8px 0;text-align:center;\">\n        <p style=\"margin:0 0 10px;font-size:12px;line-height:19px;color:#536371;\">Vous n’êtes pas à l’origine de cette inscription ?<br>Ignorez simplement cet e-mail.</p>\n        <p style=\"margin:0;font-size:12px;line-height:19px;color:#6c746f;\">LSNB Alumni<br>Lycée Scientifique National de Bobo-Dioulasso</p>\n      </td></tr>\n    </table>\n    <!--[if mso]></td></tr></table><![endif]-->\n  </td></tr></table>\n</body></html>"
}
