{
  "name": "lsnb-alumni",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:hub": "vite --config vite.hub.config.ts",
    "build:hub": "tsc -b && vite build --config vite.hub.config.ts",
    "preview:hub": "vite preview --config vite.hub.config.ts",
    "dev:api": "npm --prefix api run dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix api run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "npm --prefix api run typecheck",
    "test:api": "npm --prefix api run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "animejs": "^4.1.3",
    "clsx": "^2.1.1",
    "d3-geo": "3.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "three": "^0.180.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
